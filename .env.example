# Variables de entorno del servidor (PROJECTO DELIVERY)
# Copia este archivo a `.env` para desarrollo local.
# En producción (Render), configura estas variables en el dashboard del servicio
# o desde render.yaml. NUNCA commitees tu `.env` real.

# Token del bot de Telegram que envía alertas a los repartidores.
# Formato: <bot_id>:<token_alphanumeric>. Ejemplo: 123456789:AAH...
# Si está vacío, las notificaciones simplemente no se envían.
TELEGRAM_BOT_TOKEN=

# Directorio donde se persiste el archivo SQLite (data/reparto.db).
# En Render se monta el disco persistente en /var/data.
# En local puedes omitirlo (se usa ./data por defecto).
DATA_DIR=
